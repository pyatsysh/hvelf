{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hvelf",
  "version": "0.1.0",
  "identifier": "app.hvelf",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "hvelf",
        "width": 760,
        "height": 540,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon-512.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "xdg-utils"
        ]
      }
    }
  }
}
